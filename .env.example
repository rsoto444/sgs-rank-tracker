# Database (Neon via Vercel works out of the box)
DATABASE_URL=

# Any long random string. Signs the login cookie.
AUTH_SECRET=

# Your first admin login, created on the first deploy
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Protects the daily refresh job. Vercel sends it automatically.
CRON_SECRET=

# DataForSEO API login (dataforseo.com - API Access page)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Google service account key (the whole JSON, or base64 of it)
GOOGLE_SERVICE_ACCOUNT_JSON=
